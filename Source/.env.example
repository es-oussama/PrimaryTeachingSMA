# ============================================================
# PrimaryTeachingSMA - Configuration Variables
# Copier ce fichier vers .env et remplir les valeurs
# ============================================================

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-api03-VOTRE_CLE_ICI

# --- Google Gemini / Imagen 3 (illustrations PDF — optionnel) ---
# Clé gratuite sur : aistudio.google.com -> Get API Key -> copier AIza...
# Sans cette clé, le PDF est généré sans illustrations (fonctionnel)
GOOGLE_API_KEY=AIza_VOTRE_CLE_ICI

# --- Modèle Claude ---
CLAUDE_MODEL=claude-opus-4-7

# --- RAG Configuration ---
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# --- PDF Output ---
OUTPUT_DIR=./outputs

# --- Logs ---
LOG_LEVEL=INFO
LOG_FILE=./outputs/agents.log

# --- n8n Webhook (optionnel) ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/primary-teaching

# --- Limites tokens (anti-hallucination) ---
MAX_TOKENS_PER_AGENT=1500
CONTEXT_WINDOW_LIMIT=4000
